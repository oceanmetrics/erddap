<?xml version="1.0" encoding="ISO-8859-1" ?>
<erddapDatasets>
<!-- erddap.oceanmetrics.io — re-served upstream grids. <redirect>false</redirect> makes THIS server
     fetch and reformat the data so browser clients get CORS + Parquet. Keep datasetIDs identical
     to the source so URLs are interchangeable. -->
<cacheMinutes>60</cacheMinutes>
<decompressedCacheMaxGB>10</decompressedCacheMaxGB>
<loadDatasetsMinMinutes>15</loadDatasetsMinMinutes>

<dataset type="EDDGridFromErddap" datasetID="jplMURSST41" active="true">
  <sourceUrl>https://coastwatch.pfeg.noaa.gov/erddap/griddap/jplMURSST41</sourceUrl>
  <redirect>false</redirect>
</dataset>

<dataset type="EDDGridFromErddap" datasetID="noaacwNPPVIIRSchlaDaily" active="true">
  <sourceUrl>https://coastwatch.noaa.gov/erddap/griddap/noaacwNPPVIIRSchlaDaily</sourceUrl>
  <redirect>false</redirect>
</dataset>

<!-- Seascapes is the one dataset here NOT mirrored with EDDGridFromErddap: the AOML source declares
     a custom colorBarPalette ("Seascapes") on CLASS, which only exists in their ERDDAP's cptfiles.
     EDDGridFromErddap copies source attributes verbatim and cannot override them, so on our
     ERDDAP 2.31 the dataset fails to load with
       "colorBarPalette=Seascapes must be one of BlackBlueWhite, ... (built-in list)".
     Mirroring via EDDGridFromDap (their ERDDAP also serves griddap over OPeNDAP) lets us use
     <addAttributes> to swap in a built-in palette. Everything else is inherited from the source. -->
<dataset type="EDDGridFromDap" datasetID="noaa_aoml_seascapes_8day" active="true">
  <sourceUrl>https://cwcgom.aoml.noaa.gov/erddap/griddap/noaa_aoml_seascapes_8day</sourceUrl>
  <reloadEveryNMinutes>10080</reloadEveryNMinutes>
  <axisVariable>
    <sourceName>time</sourceName>
    <destinationName>time</destinationName>
  </axisVariable>
  <axisVariable>
    <sourceName>latitude</sourceName>
    <destinationName>latitude</destinationName>
  </axisVariable>
  <axisVariable>
    <sourceName>longitude</sourceName>
    <destinationName>longitude</destinationName>
  </axisVariable>
  <dataVariable>
    <sourceName>CLASS</sourceName>
    <destinationName>CLASS</destinationName>
    <dataType>byte</dataType>
    <addAttributes>
      <!-- custom "Seascapes" palette is not built into ERDDAP; 33 classes over a Rainbow ramp -->
      <att name="colorBarPalette">Rainbow</att>
      <att name="colorBarMinimum" type="double">1.0</att>
      <att name="colorBarMaximum" type="double">33.0</att>
      <att name="colorBarNSections">33</att>
    </addAttributes>
  </dataVariable>
  <dataVariable>
    <sourceName>P</sourceName>
    <destinationName>P</destinationName>
    <dataType>float</dataType>
    <addAttributes>
      <att name="colorBarMinimum" type="double">0.0</att>
      <att name="colorBarMaximum" type="double">1.0</att>
    </addAttributes>
  </dataVariable>
</dataset>

<!-- ===== USF IMaRS (Tylar Murray) grids, re-served for the sanctuary climate app =====
     Source: https://erddap.marine.usf.edu/erddap (ERDDAP 2.25, nginx, no CORS). Same datasetIDs as the
     source. Plain EDDGridFromErddap + redirect=false, as for jplMURSST41 above; none of these declares a
     custom colorBarPalette. All lon -180..180. Checked 2026-10-07. -->

<!-- https://erddap.marine.usf.edu/erddap/griddap/CMEMS_PHY_MONTHLY
     variables: so (surface salinity only, single depth 0.49 m; despite the name ~2.3-day steps, 462 steps 2022-06..2025-05). NB the source has no thetao
     time x depth(1) x lat(2041) x lon(4320), 1/12 deg -->
<dataset type="EDDGridFromErddap" datasetID="CMEMS_PHY_MONTHLY" active="true">
  <sourceUrl>https://erddap.marine.usf.edu/erddap/griddap/CMEMS_PHY_MONTHLY</sourceUrl>
  <reloadEveryNMinutes>1440</reloadEveryNMinutes>
  <redirect>false</redirect>
</dataset>

